# Server
PORT=3000
# 公開網站 URL；email 連結與 RSS Feed 的 canonical URL 都使用它
BASE_URL=https://yourdomain.com

# Admin
ADMIN_PASSWORD=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
ADMIN_EMAIL=

# Scheduler
SCAN_INTERVAL_HOURS=6   # scanner 執行間隔（小時）
DIGEST_HOUR=6           # digest 每天幾點寄出（24h）

# Scanner
SCANNER_CONCURRENCY=32
